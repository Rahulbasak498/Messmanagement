rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This app uses one shared mess ledger. Only signed-in accounts can read
    // or change monthly records.
    match /months/{monthId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      function validProfile(data) {
        return data.keys().hasAll(['name', 'email', 'mobile', 'updatedAt'])
          && data.keys().hasOnly(['name', 'email', 'mobile', 'updatedAt'])
          && data.name is string && data.name.size() > 0
          && data.email is string && data.email == request.auth.token.email
          && data.mobile is string && data.mobile.size() > 0
          && data.updatedAt is int;
      }

      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validProfile(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email;
    }
  }
}
